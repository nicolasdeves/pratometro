# Copie para .env na raiz. Em packages/database/.env basta o DATABASE_URL (variáveis
# vazias ali ganham das da raiz, porque o Prisma carrega o arquivo antes). A API lê o .env da raiz
# (apps/api/.env é opcional e, se existir, tem prioridade).

# Banco local do docker-compose.yml
DATABASE_URL=postgresql://pratometro:pratometro@localhost:5442/pratometro

# API
PORT=7720
NODE_ENV=development
JWT_ACCESS_SECRET=dev-trocar
JWT_ACCESS_TTL=15m

# Login com Google: Client ID OAuth do tipo "Aplicativo da Web".
# Origens JavaScript autorizadas: http://localhost:7721 e https://pratometro.nicolasdeves.com.br
GOOGLE_CLIENT_ID=

# Login com e-mail e senha: só para testes locais. Em produção fica desligado
# (sem a variável) e o único acesso é pelo Google.
AUTH_PASSWORD_LOGIN=true

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Modelo usado nas análises (lista: ai.models.list). Padrão: gemini-3.5-flash
GEMINI_MODEL=gemini-3.5-flash
# Reservas, tentados em ordem quando o principal está sobrecarregado (503/429).
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite
