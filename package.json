{
  "name": "pratometro",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@10.9.9",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "db:migrate": "npm run migrate -w @pratometro/database",
    "db:deploy": "npm run deploy -w @pratometro/database"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.5.0",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
